# ---------------------------------------------------------
# Local PostgreSQL
# ---------------------------------------------------------

# Name of the local PostgreSQL database
POSTGRES_DB=commercepilot

# Administrator account for database setup and data loading
POSTGRES_USER=commercepilot_admin

# Replace this placeholder in your private .env file
POSTGRES_PASSWORD=replace_with_your_local_password

# Port used to connect from your laptop
POSTGRES_PORT=5432

# Read-only account used by the analytics agent
POSTGRES_READONLY_USER=commercepilot_reader
POSTGRES_READONLY_PASSWORD=replace_with_your_readonly_password


# ---------------------------------------------------------
# Groq
# ---------------------------------------------------------

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b


# ---------------------------------------------------------
# Public-demo safeguards
# ---------------------------------------------------------

# Maximum requests allowed per client within the rate-limit window.
PUBLIC_RATE_LIMIT_REQUESTS=10

# Rate-limit window in seconds.
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=600

# How long successful answers remain cached, in seconds.
ANSWER_CACHE_TTL_SECONDS=900

# Maximum number of cached answers kept in memory.
ANSWER_CACHE_MAX_ENTRIES=128