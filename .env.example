# Name of the local PostgreSQL database
POSTGRES_DB=commercepilot

# Administrator account for database setup and data loading
POSTGRES_USER=commercepilot_admin

# Replace this placeholder in your private .env file
POSTGRES_PASSWORD=replace_with_your_local_password

# Port used to connect from your laptop
POSTGRES_PORT=5432

# Read-only account for the analytics agent
POSTGRES_READONLY_USER=commercepilot_reader
POSTGRES_READONLY_PASSWORD=replace_with_your_readonly_password

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b